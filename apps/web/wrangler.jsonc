{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "osiris-web",
	"main": "src/index.js",
	"compatibility_date": "2026-08-28",

	// O catch de /api/* loga a mensagem real do D1; sem observability esse log nao e retido.
	"observability": { "enabled": true },
	"upload_source_maps": true,

	// Explicitos porque o default esconde superficie de rede: preview_urls segue o
	// workers_dev, entao cada version upload ganha a sua URL publica. Quem protege isto e o
	// Access, que nao tem chave de wrangler e vive no painel (Workers & Pages > osiris-web).
	"workers_dev": true,
	"preview_urls": true,

	"assets": {
		"directory": "./public/",
		"binding": "ASSETS",
	},

	// Mesmo banco e mesmas migrations do apps/bot.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "osiris-db",
			"database_id": "c1f8cfaf-34ee-45fb-9acc-284b31195f34",
			"migrations_dir": "../../migrations",
		},
	],

	"dev": {
		"port": 8788,
	},
}
