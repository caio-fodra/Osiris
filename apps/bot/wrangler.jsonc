{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "osiris-bot",
	"main": "src/index.js",
	"compatibility_date": "2026-08-25",
	"observability": { "enabled": true },
	"upload_source_maps": true,

	// Banco compartilhado com apps/web, entao migrations/ mora na raiz. O wrangler resolve
	// migrations_dir relativo a este arquivo.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "osiris-db",
			"database_id": "c1f8cfaf-34ee-45fb-9acc-284b31195f34",
			"migrations_dir": "../../migrations",
		},
	],

	// So os nomes; o valor vai por `wrangler secret put`. O deploy recusa subir se faltar um
	// ("The following required secrets have not been set"). Cuidado: com "secrets" declarado
	// o wrangler injeta do .dev.vars apenas as chaves desta lista, e nao avisa do que ficou.
	"secrets": {
		"required": ["TELEGRAM_TOKEN", "TG_SECRET", "MY_CHAT_ID"],
	},

	"triggers": {
		// UTC-3 fixo desde 2019, entao 13:00 UTC = 10:00 em SP.
		"crons": ["0 13 * * *"],
	},

	// 8788 e do web; assim da pra rodar os dois `dev` juntos.
	"dev": {
		"port": 8787,
	},
}
